#!/bin/sh
#
# @name Gazebo HAUV 4+1
#
# @type Quadrotor x
# @class Copter
#
# Four aerial motors and the horizontal T500 use one configurable allocator.
# Water mode commands forward thrust with the T500 and yaw with differential
# torque from the four aerial motors.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=hauv_pool}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=hauv_4plus1}

param set-default SIM_GZ_EN 1
param set-default COM_RC_IN_MODE 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 5
# Motor 5 is the bidirectional T500 thruster.
param set-default CA_R_REV 16

# Motor centers from AUAV-draft.step SunnySky under Big (match Gazebo rotor_0..3 poses).
param set-default CA_ROTOR0_PX  0.280
param set-default CA_ROTOR0_PY -0.275
param set-default CA_ROTOR0_KM  0.08

param set-default CA_ROTOR1_PX -0.280
param set-default CA_ROTOR1_PY  0.275
param set-default CA_ROTOR1_KM  0.08

param set-default CA_ROTOR2_PX  0.280
param set-default CA_ROTOR2_PY  0.275
param set-default CA_ROTOR2_KM -0.08

param set-default CA_ROTOR3_PX -0.270
param set-default CA_ROTOR3_PY -0.275
param set-default CA_ROTOR3_KM -0.08

# T500 thrust axis in body coordinates (aft estimate from CAD hull bbox).
# Vertical offset omitted until Water-mode pitch stabilization is added.
param set-default CA_ROTOR4_PX -0.50
param set-default CA_ROTOR4_PY  0.00
param set-default CA_ROTOR4_PZ  0.00
param set-default CA_ROTOR4_AX  1.00
param set-default CA_ROTOR4_AY  0.00
param set-default CA_ROTOR4_AZ  0.00
param set-default CA_ROTOR4_KM  0.00

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105

param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MIN5 0

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000
param set-default SIM_GZ_EC_MAX5 1000

param set-default SIM_GZ_EC_DIS5 0
param set-default SIM_GZ_EC_FAIL5 0

# Avoid simulator ESC telemetry differences blocking this development airframe.
param set-default FD_ESCS_EN 0

# Water mode is intentionally armed while floating. The four aerial motors use
# a small controller idle thrust so differential yaw is immediately available.
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1

# Provisional value matched to the placeholder 8 kg model.
param set-default MPC_THR_HOVER 0.55
param set-default NAV_DLL_ACT 2

hauv_water_control start
