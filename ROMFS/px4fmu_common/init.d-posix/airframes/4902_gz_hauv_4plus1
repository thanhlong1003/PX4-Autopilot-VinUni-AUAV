#!/bin/sh
#
# @name Gazebo HAUV 4+1
#
# @type Quadrotor x
# @class Copter
#
# Four aerial motors and the horizontal T500 use one configurable allocator.
# Water mode commands forward thrust with the T500 and yaw with differential
# torque from the four aerial motors.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=hauv_pool}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=hauv_4plus1}

param set-default SIM_GZ_EN 1
param set-default COM_RC_IN_MODE 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 5
# Motor 5 is the bidirectional T500 thruster.
param set-default CA_R_REV 16

# Motor centers in PX4 FRD (+X forward, +Y right). Gazebo SDF is FLU (+Y left),
# so CA_ROTOR*_PY = -gazebo_y (same as 4001_gz_x500).
# After CAD yaw +90deg: m0 front-left, m1 rear-right, m2 rear-left, m3 front-right.
param set-default CA_ROTOR0_PX  0.275
param set-default CA_ROTOR0_PY -0.280
param set-default CA_ROTOR0_KM  0.028

param set-default CA_ROTOR1_PX -0.275
param set-default CA_ROTOR1_PY  0.280
param set-default CA_ROTOR1_KM  0.028

param set-default CA_ROTOR2_PX -0.275
param set-default CA_ROTOR2_PY -0.280
param set-default CA_ROTOR2_KM -0.028

param set-default CA_ROTOR3_PX  0.275
param set-default CA_ROTOR3_PY  0.270
param set-default CA_ROTOR3_KM -0.028

# T500 in center aft bulkhead hole. Gazebo FLU (-0.40, 0, -0.14).
param set-default CA_ROTOR4_PX -0.40
param set-default CA_ROTOR4_PY  0.00
param set-default CA_ROTOR4_PZ -0.14
param set-default CA_ROTOR4_AX  1.00
param set-default CA_ROTOR4_AY  0.00
param set-default CA_ROTOR4_AZ  0.00
param set-default CA_ROTOR4_KM  0.00

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105

param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MIN5 0

param set-default SIM_GZ_EC_MAX1 603
param set-default SIM_GZ_EC_MAX2 603
param set-default SIM_GZ_EC_MAX3 603
param set-default SIM_GZ_EC_MAX4 603
param set-default SIM_GZ_EC_MAX5 246

param set-default SIM_GZ_EC_DIS5 0
param set-default SIM_GZ_EC_FAIL5 0

# Avoid simulator ESC telemetry differences blocking this development airframe.
param set-default FD_ESCS_EN 0

# Stay armed after water/ground contact (default COM_DISARM_LAND=2s would cut
# motors on splashdown → nose-dive + sink). Water mode needs motors for yaw.
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1
# Slower land-detect so bobbing on the surface is not instantly "landed".
param set-default LNDMC_TRIG_TIME 5.0

# Hover ~10 kg with V5210+C18 (~36 N/motor max); T∝ω² so hover cmd ~0.7–0.83.
param set-default MPC_THR_HOVER 0.70
# Idle spin when armed (flight); water mode uses HAUV_W_Q_IDLE for yaw motors.
param set-default MPC_THR_MIN 0.12
param set-default NAV_DLL_ACT 2

hauv_water_control start
