#!/bin/sh
#
# @name Gazebo HAUV 4+1
#
# @type Quadrotor x
# @class Copter
#
# V2 CAD: 19 kg, SunnySky X6215S + 22x6.6 physics, Blue Robotics T200 thruster,
# Samsung 50S 12S6P 30 Ah. Four aerial motors + bidirectional T200; water mode
# uses forward thrust on T200 and yaw via differential aerial torque.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=hauv_pool}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=hauv_4plus1}

param set-default SIM_GZ_EN 1
param set-default COM_RC_IN_MODE 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 5
# Motor 5 is the bidirectional T200 thruster.
param set-default CA_R_REV 16

# Motor centers in PX4 FRD (+X forward, +Y right). Gazebo SDF is FLU (+Y left),
# so CA_ROTOR*_PY = -gazebo_y (frame_align.json). 0=FL, 1=BR, 2=BL, 3=FR.
param set-default CA_ROTOR0_PX  0.36
param set-default CA_ROTOR0_PY -0.421
param set-default CA_ROTOR0_KM  0.028

param set-default CA_ROTOR1_PX -0.36
param set-default CA_ROTOR1_PY  0.402
param set-default CA_ROTOR1_KM  0.028

param set-default CA_ROTOR2_PX -0.36
param set-default CA_ROTOR2_PY -0.421
param set-default CA_ROTOR2_KM -0.028

param set-default CA_ROTOR3_PX  0.36
param set-default CA_ROTOR3_PY  0.402
param set-default CA_ROTOR3_KM -0.028

# T200 aft bulkhead (Gazebo FLU -0.36865, 0, -0.13894).
param set-default CA_ROTOR4_PX -0.36865
param set-default CA_ROTOR4_PY  0.00
param set-default CA_ROTOR4_PZ -0.13894
param set-default CA_ROTOR4_AX  1.00
param set-default CA_ROTOR4_AY  0.00
param set-default CA_ROTOR4_AZ  0.00
param set-default CA_ROTOR4_KM  0.00

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_FUNC5 105

param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0
param set-default SIM_GZ_EC_MIN5 0

# X6215S @ 50 V ref (rad/s); live V scales ω via SIM_GZ_VREF.
param set-default SIM_GZ_EC_MAX1 836
param set-default SIM_GZ_EC_MAX2 836
param set-default SIM_GZ_EC_MAX3 836
param set-default SIM_GZ_EC_MAX4 836
param set-default SIM_GZ_EC_MAX5 426

param set-default SIM_GZ_EC_DIS5 0
param set-default SIM_GZ_EC_FAIL5 0

# Scale aerial ESC commands by battery_status.voltage_v / 50.
param set-default SIM_GZ_VREF 50.0
param set-default SIM_GZ_V_N 4

# Avoid simulator ESC telemetry differences blocking this development airframe.
param set-default FD_ESCS_EN 0

# Stay armed after water/ground contact (default COM_DISARM_LAND=2s would cut
# motors on splashdown → nose-dive + sink). Water mode needs motors for yaw.
param set-default COM_DISARM_LAND -1
param set-default COM_DISARM_PRFLT -1
# Slower land-detect so bobbing on the surface is not instantly "landed".
param set-default LNDMC_TRIG_TIME 5.0

# Hover ~19 kg with X6215S @ 50 V.
param set-default MPC_THR_HOVER 0.48
# Idle spin when armed (flight); water mode uses HAUV_W_Q_IDLE for yaw motors.
param set-default MPC_THR_MIN 0.08
param set-default NAV_DLL_ACT 2

# Pack: Samsung 50S 12S6P 30 Ah. Failsafe 42 V (= 3.5 V/cell).
param set-default BAT1_N_CELLS 12
param set-default BAT1_CAPACITY 30000
param set-default BAT1_V_CHARGED 4.20
param set-default BAT1_V_EMPTY 3.50
param set-default BAT1_R_INTERNAL 0.004
param set-default BAT_AVRG_CURRENT 80
# SoC thresholds (voltage bottoms at 42 V when remaining→0).
param set-default BAT_LOW_THR 0.20
param set-default BAT_CRIT_THR 0.10
param set-default BAT_EMERGEN_THR 0.05
# 3 = RTL at critical, land at emergency (voltage floor via BAT1_V_EMPTY).
param set-default COM_LOW_BAT_ACT 3

# SITL battery: power from X6215S+22x6.6 + T200 curves; reset full on disarm.
param set-default SIM_BAT_ENABLE 1
param set-default SIM_BAT_SRC 1
param set-default SIM_BAT_IDLE_A 3.0
param set-default SIM_BAT_MIN_PCT 0
# 1 = X6215S+22x6.6 current LUTs (see BatterySimulator).
param set-default SIM_BAT_PROP 1

hauv_water_control start
