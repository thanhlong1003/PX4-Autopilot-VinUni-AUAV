<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="hauv_pool">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::AirSpeed" filename="gz-sim-air-speed-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>true</grid>
      <ambient>0.45 0.45 0.50 1</ambient>
      <background>0.65 0.78 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- A 50 x 36 m dry deck surrounds a 24 x 16 x 3 m test pool. -->
    <model name="pool_structure">
      <static>true</static>
      <link name="structure">
        <collision name="deck_west">
          <pose>-18.5 0 0 0 0 0</pose>
          <geometry><box><size>13 36 0.5</size></box></geometry>
        </collision>
        <visual name="deck_west_visual">
          <pose>-18.5 0 0 0 0 0</pose>
          <geometry><box><size>13 36 0.5</size></box></geometry>
          <material><diffuse>0.55 0.55 0.50 1</diffuse></material>
        </visual>

        <collision name="deck_east">
          <pose>18.5 0 0 0 0 0</pose>
          <geometry><box><size>13 36 0.5</size></box></geometry>
        </collision>
        <visual name="deck_east_visual">
          <pose>18.5 0 0 0 0 0</pose>
          <geometry><box><size>13 36 0.5</size></box></geometry>
          <material><diffuse>0.55 0.55 0.50 1</diffuse></material>
        </visual>

        <collision name="deck_north">
          <pose>0 13 0 0 0 0</pose>
          <geometry><box><size>24 10 0.5</size></box></geometry>
        </collision>
        <visual name="deck_north_visual">
          <pose>0 13 0 0 0 0</pose>
          <geometry><box><size>24 10 0.5</size></box></geometry>
          <material><diffuse>0.55 0.55 0.50 1</diffuse></material>
        </visual>

        <collision name="deck_south">
          <pose>0 -13 0 0 0 0</pose>
          <geometry><box><size>24 10 0.5</size></box></geometry>
        </collision>
        <visual name="deck_south_visual">
          <pose>0 -13 0 0 0 0</pose>
          <geometry><box><size>24 10 0.5</size></box></geometry>
          <material><diffuse>0.55 0.55 0.50 1</diffuse></material>
        </visual>

        <collision name="pool_floor">
          <pose>0 0 -3.25 0 0 0</pose>
          <geometry><box><size>24 16 0.5</size></box></geometry>
        </collision>
        <visual name="pool_floor_visual">
          <pose>0 0 -3.25 0 0 0</pose>
          <geometry><box><size>24 16 0.5</size></box></geometry>
          <material><diffuse>0.18 0.48 0.62 1</diffuse></material>
        </visual>

        <collision name="pool_wall_west">
          <pose>-12.15 0 -1.5 0 0 0</pose>
          <geometry><box><size>0.3 16.6 3.5</size></box></geometry>
        </collision>
        <visual name="pool_wall_west_visual">
          <pose>-12.15 0 -1.5 0 0 0</pose>
          <geometry><box><size>0.3 16.6 3.5</size></box></geometry>
          <material><diffuse>0.22 0.58 0.72 1</diffuse></material>
        </visual>

        <collision name="pool_wall_east">
          <pose>12.15 0 -1.5 0 0 0</pose>
          <geometry><box><size>0.3 16.6 3.5</size></box></geometry>
        </collision>
        <visual name="pool_wall_east_visual">
          <pose>12.15 0 -1.5 0 0 0</pose>
          <geometry><box><size>0.3 16.6 3.5</size></box></geometry>
          <material><diffuse>0.22 0.58 0.72 1</diffuse></material>
        </visual>

        <collision name="pool_wall_north">
          <pose>0 8.15 -1.5 0 0 0</pose>
          <geometry><box><size>24 0.3 3.5</size></box></geometry>
        </collision>
        <visual name="pool_wall_north_visual">
          <pose>0 8.15 -1.5 0 0 0</pose>
          <geometry><box><size>24 0.3 3.5</size></box></geometry>
          <material><diffuse>0.22 0.58 0.72 1</diffuse></material>
        </visual>

        <collision name="pool_wall_south">
          <pose>0 -8.15 -1.5 0 0 0</pose>
          <geometry><box><size>24 0.3 3.5</size></box></geometry>
        </collision>
        <visual name="pool_wall_south_visual">
          <pose>0 -8.15 -1.5 0 0 0</pose>
          <geometry><box><size>24 0.3 3.5</size></box></geometry>
          <material><diffuse>0.22 0.58 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The water plane is visual-only; buoyancy is provided by the system below. -->
    <model name="pool_water">
      <static>true</static>
      <link name="water">
        <visual name="surface">
          <pose>0 0 0 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>24 16</size></plane></geometry>
          <material>
            <ambient>0.04 0.24 0.38 0.55</ambient>
            <diffuse>0.05 0.38 0.62 0.55</diffuse>
            <specular>0.8 0.8 0.9 1</specular>
          </material>
          <transparency>0.45</transparency>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.2 0.1 -0.97</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.3979710577</latitude_deg>
      <longitude_deg>8.5461637398</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <plugin filename="libBuoyancySystemPlugin.so"
      name="gz::sim::systems::BuoyancySystem">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
      <!-- PX4 names the first vehicle hauv_4plus1_0; also allow unscoped. -->
      <enable>hauv_4plus1_0::base_link</enable>
      <enable>hauv_4plus1::base_link</enable>
    </plugin>
  </world>
</sdf>
