<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="hauv_coast">
    <!-- Compact coastal bay with animated Gerstner waves (gazebo_maritime WaveVisual).
         Visual ocean ~6 km (coast_waves). Dry pad for spawn; buoyancy waterline z=0. -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::AirSpeed" filename="gz-sim-air-speed-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.35 0.42 0.50 1</ambient>
      <background>0.45 0.62 0.78 1</background>
      <shadows>true</shadows>
      <sky>
        <time>15.0</time>
        <sunrise>6.0</sunrise>
        <sunset>18.5</sunset>
        <clouds>
          <speed>0.6</speed>
          <direction>1.0 0.2</direction>
          <humidity>0.5</humidity>
          <mean_size>0.7</mean_size>
          <ambient>0.88 0.90 0.94</ambient>
        </clouds>
      </sky>
      <fog>
        <color>0.55 0.68 0.80 1</color>
        <type>linear</type>
        <start>40</start>
        <end>280</end>
        <density>0.015</density>
      </fog>
    </scene>

    <!-- Animated Gerstner ocean (requires libWaveVisual.so from /opt/hauv-maritime). -->
    <include>
      <name>coast_waves</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://coast_waves</uri>
    </include>

    <!-- Seabed for crash / dive (compact working area). -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -12 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><diffuse>0.18 0.16 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small shore pad (flight spawn). Top ≈ z=+0.3 m. -->
    <model name="coast_pad">
      <static>true</static>
      <pose>0 -22 0 0 0 0</pose>
      <link name="pad">
        <collision name="deck">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>12 8 0.6</size></box></geometry>
        </collision>
        <visual name="deck_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>12 8 0.6</size></box></geometry>
          <material><diffuse>0.50 0.46 0.38 1</diffuse></material>
        </visual>
        <collision name="beach_lip">
          <pose>0 5.5 -0.05 0 0 0</pose>
          <geometry><box><size>14 3.5 0.35</size></box></geometry>
        </collision>
        <visual name="beach_lip_visual">
          <pose>0 5.5 -0.05 0 0 0</pose>
          <geometry><box><size>14 3.5 0.35</size></box></geometry>
          <material><diffuse>0.78 0.68 0.48 1</diffuse></material>
        </visual>
        <collision name="bluff">
          <pose>0 -5.5 1.2 0 0 0</pose>
          <geometry><box><size>14 2.5 2.4</size></box></geometry>
        </collision>
        <visual name="bluff_visual">
          <pose>0 -5.5 1.2 0 0 0</pose>
          <geometry><box><size>14 2.5 2.4</size></box></geometry>
          <material><diffuse>0.42 0.40 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_near_e">
      <static>true</static>
      <pose>18 -16 0.4 0.1 0.05 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.5 2.2 1.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>3.5 2.2 1.8</size></box></geometry>
          <material><diffuse>0.38 0.36 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="rock_near_w">
      <static>true</static>
      <pose>-16 -18 0.25 -0.05 0.08 -0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.8 3.0 1.4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>2.8 3.0 1.4</size></box></geometry>
          <material><diffuse>0.40 0.37 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="buoy_near">
      <static>true</static>
      <pose>25 15 0.55 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cylinder><radius>0.35</radius><length>0.9</length></cylinder></geometry>
          <material><diffuse>0.85 0.15 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 120 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.35 0.20 -0.90</direction>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.5 0.48 0.42 1</specular>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>20.9101</latitude_deg>
      <longitude_deg>107.1839</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Drive WaveVisual + Surface Gerstner (coastal swell scaled to HAUV freeboard). -->
    <plugin filename="libPublisherPlugin.so" name="maritime::PublisherPlugin">
      <message type="gz.msgs.Param" topic="/gazebo/wavefield/parameters"
               every="1.0">
        params {
          key: "model"
          value {
            type: STRING
            string_value: "PMS"
          }
        }
        params {
          key: "direction"
          value {
            type: DOUBLE
            double_value: 0.55
          }
        }
        <!-- gain~0.42 → component amps ~0.1–0.15 m (was 0.72 ≈ ±0.5 m wash-over
             on a ~0.2 m freeboard HAUV while heave was over-damped). -->
        params {
          key: "gain"
          value {
            type: DOUBLE
            double_value: 0.42
          }
        }
        params {
          key: "period"
          value {
            type: DOUBLE
            double_value: 6.0
          }
        }
        params {
          key: "steepness"
          value {
            type: DOUBLE
            double_value: 0.28
          }
        }
        params {
          key: "scale"
          value {
            type: DOUBLE
            double_value: 1.25
          }
        }
        params {
          key: "angle"
          value {
            type: DOUBLE
            double_value: 0.55
          }
        }
        params {
          key: "tau"
          value {
            type: DOUBLE
            double_value: 1.5
          }
        }
      </message>
    </plugin>

    <!-- Buoyancy: maritime::Surface on hauv_4plus1 (wave η), not BuoyancySystem. -->
  </world>
</sdf>
