    <link name="base_link">
      <inertial>
        <!-- TBD: replace with measured all-up mass including CPS05. -->
        <!-- Sealed hull, pontoons and T500 housing are combined in base_link. -->
        <!-- Batteries and electronics keep the center of mass below the
             flotation center so the surface vehicle self-rights. -->
        <pose>-0.026 0 -0.052 0 0 0</pose>
        <mass>7.94</mass>
        <inertia>
          <!-- TBD: replace with measured or CAD-derived inertia tensor. -->
          <ixx>0.45</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.28</iyy>
