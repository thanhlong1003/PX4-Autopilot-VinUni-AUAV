<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hauv_4plus1'>
    <!-- z ≈ |visual_zmin| so pontoon keels sit on z=0 when spawned at origin. -->
    <pose>0 0 0.25 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <!-- Dry mass measured 9 kg. Box inertia from CAD bbox after +90° yaw
             (Lx≈1.46, Ly≈0.93, Lz≈0.43). COM low for float stability.
             See meshes/hydro_physics.json. -->
        <pose>0 0 -0.10 0 0 0</pose>
        <mass>9.0</mass>
        <inertia>
          <ixx>0.787</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.737</iyy>
          <iyz>0</iyz>
          <izz>2.247</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <!-- Light air damping only; water drag from Hydrodynamics below. -->
      <velocity_decay>
        <linear>0.05</linear>
        <angular>0.15</angular>
      </velocity_decay>
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/hauv_big.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.55 0.58 0.62 1</diffuse></material>
      </visual>
      <!-- Buoyancy boxes aligned to VISUAL pontoons (STL |y|>0.4 → z∈[-0.13,0.09]),
           not landing-gear tips. Half-height volume ≈ 9 L − keel so waterline
           sits mid-pontoon (see meshes/hydro_physics.json). -->
      <collision name="pontoon_port_collision">
        <pose>0 0.55 -0.02 0 0 0</pose>
        <geometry><box><size>0.8 0.05005 0.22</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <collision name="pontoon_starboard_collision">
        <pose>0 -0.55 -0.02 0 0 0</pose>
        <geometry><box><size>0.8 0.05005 0.22</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <!-- Ground contact only; volume kept tiny so it barely affects float draft. -->
      <collision name="keel_collision">
        <pose>0 0 -0.237 0 0 0</pose>
        <geometry><box><size>0.40 0.08 0.006</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- SunnySky X4120 V3 motors (CAD poses after yaw +90; mesh may still be V5210 body). -->
      <visual name="motor_0_visual">
        <pose>0.274642 0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_1_visual">
        <pose>-0.275358 -0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_2_visual">
        <pose>-0.275358 0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_3_visual">
        <pose>0.274642 -0.270145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <!-- T500 in center aft bulkhead hole (y=0, r≈0.08). Not on a pontoon. -->
      <visual name="t500_body_visual">
        <pose>-0.40 0 -0.14 0 1.57079632679 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/t500_thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.05 0.45 0.95 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.274642 0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <!-- Physics: 15x8. Visual: 18x6.1 STL scaled ≈15/18 until 15x8 CAD. -->
      <visual name="rotor_0_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_ccw.stl</uri>
            <scale>0.833 0.833 0.833</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.275358 -0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_ccw.stl</uri>
            <scale>0.833 0.833 0.833</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.275358 0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_cw.stl</uri>
            <scale>0.833 0.833 0.833</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.274642 -0.270145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_cw.stl</uri>
            <scale>0.833 0.833 0.833</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- T500 actuator link (physics). Housing mesh is on base_link. -->
    <link name="t500_rotor">
      <pose>-0.40 0 -0.14 0 1.57079632679 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="t500_joint" type="revolute">
      <parent>base_link</parent>
      <child>t500_rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Hydrodynamics from meshes/hydro_physics.json (viscous + effective
         wave Cd; measured 9 kg; half-draft float). Not visual fine-tuning. -->
    <plugin filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-10.0</xU><xUabsU>-16.79</xUabsU>
      <yV>-20.0</yV><yVabsV>-105.6</yVabsV>
      <zW>-35.0</zW><zWabsW>-40.04</zWabsW>
      <kP>-8.0</kP><kPabsP>-12.11</kPabsP>
      <mQ>-18.0</mQ><mQabsQ>-6.41</mQabsQ>
      <!-- Yaw: pontoons see surge u=±y·r → frontal area (not lateral). -->
      <nR>-3.0</nR><nRabsR>-5.08</nRabsR>
    </plugin>

    <!-- Propulsion from datasheets (see meshes/propulsion_physics.json).
         Aerial: SunnySky X4120 V3 + 15x8 @ 20.31 V / 43.08 A → 3962 g @ 7539 RPM.
         Horizontal: T200 physics (temp) @ 20 V → ~66 N @ 4067 RPM; visual still T500.
         Gazebo: thrust = motorConstant * omega^2, omega command in rad/s. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>789.5</maxRotVelocity><motorConstant>6.235894e-05</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>789.5</maxRotVelocity><motorConstant>6.235894e-05</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>789.5</maxRotVelocity><motorConstant>6.235894e-05</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>789.5</maxRotVelocity><motorConstant>6.235894e-05</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>

    <!-- T200 physics @ 20 V: 6.7 kgf @ ~4067 RPM (visual mesh still T500). -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>t500_joint</jointName><linkName>t500_rotor</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.08</timeConstantUp><timeConstantDown>0.12</timeConstantDown>
      <maxRotVelocity>425.9</maxRotVelocity><motorConstant>3.623815e-04</motorConstant>
      <momentConstant>0</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber><rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
