<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hauv_4plus1'>
    <!-- z ≈ |visual_zmin| so pontoon keels sit on z=0 when spawned at origin. -->
    <pose>0 0 0.25 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <!-- CAD Big/COMPOUND010, yawed +90deg so pontoon long axis = +X and CAD nose = +X.
             COM slightly low for float stability (below mid-pontoon). -->
        <pose>0 0 -0.10 0 0 0</pose>
        <mass>10.0</mass>
        <inertia>
          <!-- Approx box inertia for 0.93 x 1.46 x 0.43 m @ 10 kg (after yaw). -->
          <ixx>1.95</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.88</iyy>
          <iyz>0</iyz>
          <izz>2.58</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <!-- Light always-on damping; water drag comes from Hydrodynamics below. -->
      <velocity_decay>
        <linear>0.15</linear>
        <angular>0.40</angular>
      </velocity_decay>
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/hauv_big.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.55 0.58 0.62 1</diffuse></material>
      </visual>
      <!-- Buoyancy + ground contact (visual CAD size unchanged). Fresh water:
           m=10 kg => V_sub = 0.01 m^3. Target ~60% box height => V_total ≈ 0.0167
           (extra reserve so splashdown does not bury the nose).
           Long waterplane along +X (0.75 m) restores pitch; prior 0.29 m boxes
           let the nose dive and sink. Bottom on visual keel zmin≈-0.24.
           0.75*0.079*0.14 ≈ 0.0083 each. -->
      <collision name="pontoon_port_collision">
        <pose>0 0.55 -0.17 0 0 0</pose>
        <geometry><box><size>0.75 0.079 0.14</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <collision name="pontoon_starboard_collision">
        <pose>0 -0.55 -0.17 0 0 0</pose>
        <geometry><box><size>0.75 0.079 0.14</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <!-- Contact skid at visual bottom; negligible buoyancy volume. -->
      <collision name="keel_collision">
        <pose>0 0 -0.235 0 0 0</pose>
        <geometry><box><size>0.60 0.12 0.01</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- SunnySky V5210 motors (CAD poses after yaw +90). -->
      <visual name="motor_0_visual">
        <pose>0.274642 0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_1_visual">
        <pose>-0.275358 -0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_2_visual">
        <pose>-0.275358 0.280145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_3_visual">
        <pose>0.274642 -0.270145 0.131326 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <!-- T500 in center aft bulkhead hole (y=0, r≈0.08). Not on a pontoon. -->
      <visual name="t500_body_visual">
        <pose>-0.40 0 -0.14 0 1.57079632679 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/t500_thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.05 0.45 0.95 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.274642 0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <!-- CAD 18x6.1 propeller (CCW), spin about +Z. -->
      <visual name="rotor_0_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_ccw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.275358 -0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_ccw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.275358 0.280145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_cw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.274642 -0.270145 0.131326 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_18x6_1_cw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- T500 actuator link (physics). Housing mesh is on base_link. -->
    <link name="t500_rotor">
      <pose>-0.40 0 -0.14 0 1.57079632679 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="t500_joint" type="revolute">
      <parent>base_link</parent>
      <child>t500_rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Provisional water drag. Stronger pitch damping (mQ) resists nose-dive
         on splashdown; heave damping kept moderate so buoyancy can recover. -->
    <plugin filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-5.0</xU><xUabsU>-3.0</xUabsU>
      <yV>-12.0</yV><yVabsV>-8.0</yVabsV>
      <zW>-25.0</zW><zWabsW>-12.0</zWabsW>
      <kP>-10.0</kP><kPabsP>-5.0</kPabsP>
      <mQ>-20.0</mQ><mQabsQ>-10.0</mQabsQ>
      <!-- Weak yaw drag: surface steering uses small prop reaction torque (~1–2 N·m). -->
      <nR>-1.5</nR><nRabsR>-0.8</nRabsR>
    </plugin>

    <!-- Aerial propulsion constants are provisional and must be fitted to
         SunnySky X4120 V3 650KV + actual propeller test data. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity><motorConstant>5.2e-05</motorConstant>
      <momentConstant>0.08</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity><motorConstant>5.2e-05</motorConstant>
      <momentConstant>0.08</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity><motorConstant>5.2e-05</motorConstant>
      <momentConstant>0.08</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity><motorConstant>5.2e-05</motorConstant>
      <momentConstant>0.08</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>

    <!-- 91.2 N is a provisional full-scale forward force (TBD voltage and
         installation losses). Channel 5 is allocated as the fifth rotor. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>t500_joint</jointName><linkName>t500_rotor</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.10</timeConstantUp><timeConstantDown>0.15</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity><motorConstant>9.12e-05</motorConstant>
      <momentConstant>0</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber><rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
