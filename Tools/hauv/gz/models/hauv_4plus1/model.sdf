    <!-- Simplified T500: mounted aft, thrust axis along body +X. -->
    <link name="t500_rotor">
      <pose>-0.442 0 -0.06 0 1.57079632679 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.6115851691700804e-05</iyy><iyz>0</iyz><izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="t500_prop_hub_visual">
