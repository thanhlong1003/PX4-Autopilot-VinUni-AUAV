<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='hauv_4plus1'>
    <!-- z ≈ |visual_zmin| so pontoon keels sit on z=0 when spawned at origin. -->
    <pose>0 0 0.25 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <!-- Dry mass 19 kg (V2). Box inertia from CAD bbox after +90° yaw
             (Lx≈1.70, Ly≈1.134, Lz≈0.43). COM low for float stability.
             See meshes/hydro_physics.json. -->
        <pose>0 0 -0.10 0 0 0</pose>
        <mass>19.0</mass>
        <inertia>
          <ixx>2.327</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.869</iyy>
          <iyz>0</iyz>
          <izz>6.611</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <!-- Light air damping only; water drag from Hydrodynamics below. -->
      <velocity_decay>
        <linear>0.05</linear>
        <angular>0.15</angular>
      </velocity_decay>
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/hauv_big.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.55 0.58 0.62 1</diffuse></material>
      </visual>
      <!-- Tip floats at lateral boom ends (y=±0.82). Tube z≈0.07 through
           upper hole; long axis +X. Baked into hauv_big.stl too. -->
      <visual name="float_port_visual">
        <pose>0 0.82 0.12 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/float.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.95 0.55 0.12 1</diffuse>
          <ambient>0.95 0.55 0.12 1</ambient>
        </material>
      </visual>
      <visual name="float_starboard_visual">
        <pose>0 -0.82 0.12 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/float.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.95 0.55 0.12 1</diffuse>
          <ambient>0.95 0.55 0.12 1</ambient>
        </material>
      </visual>
      <!-- Buoyancy at tip-float volume. -->
      <collision name="pontoon_port_collision">
        <pose>0 0.82 -0.05 0 0 0</pose>
        <geometry><box><size>1.0 0.16 0.22</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <collision name="pontoon_starboard_collision">
        <pose>0 -0.82 -0.05 0 0 0</pose>
        <geometry><box><size>1.0 0.16 0.22</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <!-- Ground contact only; volume kept tiny so it barely affects float draft. -->
      <collision name="keel_collision">
        <pose>0 0 -0.237 0 0 0</pose>
        <geometry><box><size>0.40 0.08 0.006</size></box></geometry>
        <surface>
          <contact>
            <ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode>
          </contact>
          <friction><ode /></friction>
        </surface>
      </collision>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <!-- Noise modeled after BMP390 -->
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <!-- Noise modeled after IIM42653 -->
            <!-- 0.05 deg/s converted to rad/s -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- Noise modeled after IIM42653 -->
            <!-- X & Y axis: 0.65 mg-rms converted to m/ss -->
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <!-- Z axis: 0.70 mg-rms converted to m/ss-->
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- SunnySky X6215S motor bodies (V2 CAD poses; see meshes/frame_align.json). -->
      <visual name="motor_0_visual">
        <pose>0.36 0.421 0.143514687347 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_1_visual">
        <pose>-0.36 -0.402 0.143514687346 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_2_visual">
        <pose>-0.36 0.421 0.143514687346 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <visual name="motor_3_visual">
        <pose>0.36 -0.402 0.143514687346 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/motor_sunnysky.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.08 0.08 0.1 1</diffuse></material>
      </visual>
      <!-- T200 aft bulkhead (fixed on base_link; thrust along +X via t200_rotor). -->
      <visual name="t200_body_visual">
        <pose>-0.368651775065 0 -0.138939685413 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/t200_thruster.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.05 0.45 0.95 1</diffuse></material>
      </visual>
    </link>

    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.36 0.421 0.143514687347 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <!-- Physics: X6215S + 22×6.6. Visual: prop_22x6_* STLs. -->
      <visual name="rotor_0_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_22x6_ccw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.36 -0.402 0.143514687346 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_22x6_ccw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.36 0.421 0.143514687346 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_22x6_cw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.36 -0.402 0.143514687346 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://hauv_4plus1/meshes/prop_22x6_cw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- T200 actuator link (physics). Housing mesh is on base_link. -->
    <link name="t200_rotor">
      <pose>-0.368651775065 0 -0.138939685413 0 1.57079632679 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-4</iyy><iyz>0</iyz><izz>1e-4</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="t200_joint" type="revolute">
      <parent>base_link</parent>
      <child>t200_rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Wave-aware pontoon buoyancy (maritime::Surface). Follows Gerstner
         η(x,y,t) when PublisherPlugin drives /gazebo/wavefield/parameters.
         Replaces world BuoyancySystem for this model (avoid double lift).
         Requires libSurface.so (Docker /opt/hauv-maritime). -->
    <plugin filename="libSurface.so" name="maritime::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.00</hull_length>
      <hull_radius>0.12</hull_radius>
      <fluid_level>0</fluid_level>
      <fluid_density>1000</fluid_density>
      <points>
        <point>0.40 0.82 -0.05</point>
        <point>-0.40 0.82 -0.05</point>
      </points>
      <!-- Match coast_waves / PublisherPlugin (flat η when gain unused offline). -->
      <wavefield>
        <topic>/gazebo/wavefield/parameters</topic>
        <wave>
          <model>PMS</model>
          <gain>0</gain>
          <period>6.0</period>
          <direction>0.55</direction>
          <steepness>0.28</steepness>
          <scale>1.25</scale>
          <angle>0.55</angle>
          <tau>1.5</tau>
        </wave>
      </wavefield>
    </plugin>
    <plugin filename="libSurface.so" name="maritime::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.00</hull_length>
      <hull_radius>0.12</hull_radius>
      <fluid_level>0</fluid_level>
      <fluid_density>1000</fluid_density>
      <points>
        <point>0.40 -0.82 -0.05</point>
        <point>-0.40 -0.82 -0.05</point>
      </points>
      <wavefield>
        <topic>/gazebo/wavefield/parameters</topic>
        <wave>
          <model>PMS</model>
          <gain>0</gain>
          <period>6.0</period>
          <direction>0.55</direction>
          <steepness>0.28</steepness>
          <scale>1.25</scale>
          <angle>0.55</angle>
          <tau>1.5</tau>
        </wave>
      </wavefield>
    </plugin>

    <!-- Hydrodynamics from meshes/hydro_physics.json (viscous + effective
         wave Cd; measured 19 kg; half-draft float). Not visual fine-tuning. -->
    <plugin filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-10.0</xU><xUabsU>-16.79</xUabsU>
      <yV>-20.0</yV><yVabsV>-105.6</yVabsV>
      <!-- Heave soft enough to ride Gerstner η (was -35/-40 → craft sat at
           mean z while visual crests washed over the hull). -->
      <zW>-10.0</zW><zWabsW>-14.0</zWabsW>
      <kP>-8.0</kP><kPabsP>-12.11</kPabsP>
      <mQ>-18.0</mQ><mQabsQ>-6.41</mQabsQ>
      <!-- Yaw: pontoons see surge u=±y·r → frontal area (not lateral). -->
      <nR>-3.0</nR><nRabsR>-5.08</nRabsR>
    </plugin>

    <!-- Propulsion from datasheets (see meshes/propulsion_physics.json).
         Aerial: SunnySky X6215S + 22×6.6 @ 50 V / 60 A → 11.635 kgf @ ~7786 RPM.
         Horizontal: T200 physics @ 20 V → ~66 N @ 4067 RPM; visual t200_thruster.stl.
         Gazebo: thrust = motorConstant * omega^2, omega command in rad/s. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>815.4</maxRotVelocity><motorConstant>1.716374e-04</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>815.4</maxRotVelocity><motorConstant>1.716374e-04</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>815.4</maxRotVelocity><motorConstant>1.716374e-04</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.02</timeConstantUp><timeConstantDown>0.04</timeConstantDown>
      <maxRotVelocity>815.4</maxRotVelocity><motorConstant>1.716374e-04</motorConstant>
      <momentConstant>0.0276</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber><rotorDragCoefficient>8.0e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>

    <!-- T200 physics @ 20 V: 6.7 kgf @ ~4067 RPM. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>t200_joint</jointName><linkName>t200_rotor</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.08</timeConstantUp><timeConstantDown>0.12</timeConstantDown>
      <maxRotVelocity>425.9</maxRotVelocity><motorConstant>3.623815e-04</motorConstant>
      <momentConstant>0</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber><rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
